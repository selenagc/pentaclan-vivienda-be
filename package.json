{
  "name": "pentaclan-vivienda-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pentaclan Vivienda backend monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\"",
    "test": "npm run test --workspace=apps/api",
    "clean": "rimraf \"apps/*/dist\" \"packages/*/dist\""
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
