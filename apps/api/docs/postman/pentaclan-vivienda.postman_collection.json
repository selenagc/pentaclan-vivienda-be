    {
      "name": "Projects",
      "item": [
        {
          "name": "POST /projects",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Construccion de viviendas sociales - Fase I\",\n  \"contractNo\": \"AEV-2026-{{$randomInt}}\",\n  \"publicEntityId\": {{publicEntityId}},\n  \"municipalityId\": {{municipalityId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.environment.set('projectId', res.data.id);",
                  "pm.environment.set('contractNo', res.data.contractNo);",
                  "pm.test('el creador sale de la sesion', () => pm.expect(res.data.userName).to.eql(pm.environment.get('userName')));",
                  "pm.test('asocia la entidad financiadora', () => pm.expect(res.data.publicEntity.id).to.eql(Number(pm.environment.get('publicEntityId'))));",
                  "pm.test('registra el municipio', () => pm.expect(res.data.municipality.id).to.eql(Number(pm.environment.get('municipalityId'))));",
                  "pm.test('resuelve la cadena geografica', () => pm.expect(res.data.municipality.department).to.have.property('name'));"
                ]
              }
            }
          ]
        },
        {
