          "name": "POST /projects (401: sin sesion)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sin sesion\",\n  \"contractNo\": \"AEV-NOAUTH-001\",\n  \"publicEntityId\": 1,\n  \"municipalityId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /projects (403: rol sin permiso)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{techToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Rol sin permiso\",\n  \"contractNo\": \"AEV-FORBIDDEN-001\",\n  \"publicEntityId\": {{publicEntityId}},\n  \"municipalityId\": {{municipalityId}}\n}" },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La escritura de proyectos es admin-only: hace falta el token de otro rol.",
                  "// Depende del seeder dev de usuarios de prueba (20260607000002).",
                  "pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: pm.environment.get('techLeadEmail'), password: pm.environment.get('techLeadPassword') }) }",
                  "}, (err, res) => {",
                  "  if (err || res.code !== 200) { console.error('No se pudo obtener token de technical_lead; corre el seeder dev.'); return; }",
                  "  pm.variables.set('techToken', res.json().data.accessToken);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('el motivo es el rol', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('respuesta paginada', () => pm.expect(res.meta).to.have.property('totalPages'));",
                  "pm.test('data is array', () => pm.expect(res.data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /projects?userId (trazabilidad)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "// se filtra por el id del creador, pero la respuesta trae su nombre",
                  "const esperado = pm.environment.get('userName');",
                  "pm.test('solo proyectos del creador pedido', () => pm.expect(res.data.every((p) => p.userName === esperado)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /projects?municipalityId (ubicacion)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects?municipalityId={{municipalityId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [{ "key": "municipalityId", "value": "{{municipalityId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const esperado = Number(pm.environment.get('municipalityId'));",
                  "pm.test('solo proyectos del municipio pedido', () => pm.expect(res.data.every((p) => p.municipality.id === esperado)).to.be.true);"
                ]
              }
            }
          ]
        },
