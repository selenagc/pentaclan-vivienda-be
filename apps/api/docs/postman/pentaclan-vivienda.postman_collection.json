{
  "info": {
    "name": "Pentaclan Vivienda API",
    "description": "Colección de la API de Pentaclan Vivienda.\n\nIncluye el flujo de autenticación (PV-10: roles admin / social_lead / technical_lead / project_supervisor) y el CRUD de proyectos.\n\nUso rápido:\n1. Selecciona el environment 'Pentaclan Vivienda - Local'.\n2. Ejecuta Auth > Login (guarda accessToken, refreshToken y currentRole automáticamente).\n3. El resto de requests usan {{accessToken}} vía Bearer heredado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "pv-collection-0001-0001-0001-000000000001"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('envelope success', () => pm.expect(res.success).to.be.true);",
                  "pm.test('status ok', () => pm.expect(res.data.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const VALID_ROLES = ['admin', 'social_lead', 'technical_lead', 'project_supervisor'];",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('envelope success', () => pm.expect(res.success).to.be.true);",
                  "const data = res.data;",
                  "pm.test('tokens present', () => {",
                  "  pm.expect(data.accessToken, 'accessToken').to.be.a('string');",
                  "  pm.expect(data.refreshToken, 'refreshToken').to.be.a('string');",
                  "});",
                  "pm.test('PV-10: role is valid', () => pm.expect(VALID_ROLES).to.include(data.user.role));",
                  "pm.environment.set('accessToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);",
                  "pm.environment.set('currentRole', data.user.role);",
                  "pm.environment.set('userId', data.user.id);",
                  "console.log('Logged in as', data.user.email, '-> role:', data.user.role);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const VALID_ROLES = ['admin', 'social_lead', 'technical_lead', 'project_supervisor'];",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('no passwordHash leaked', () => pm.expect(res.data).to.not.have.property('passwordHash'));",
                  "pm.test('PV-10: role is valid', () => pm.expect(VALID_ROLES).to.include(res.data.role));",
                  "pm.test('role matches the one from login', () => pm.expect(res.data.role).to.eql(pm.environment.get('currentRole')));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const data = res.data;",
                  "pm.test('new tokens present', () => {",
                  "  pm.expect(data.accessToken, 'accessToken').to.be.a('string');",
                  "  pm.expect(data.refreshToken, 'refreshToken').to.be.a('string');",
                  "});",
                  "pm.environment.set('accessToken', data.accessToken);",
                  "pm.environment.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('envelope success', () => pm.expect(res.success).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "POST /projects",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Casa Bonita\",\n  \"description\": \"Proyecto de prueba\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.environment.set('projectId', res.data.id);",
                  "pm.test('has id', () => pm.expect(res.data.id).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('data is array', () => pm.expect(res.data).to.be.an('array'));",
                  "pm.test('has pagination meta', () => pm.expect(res.meta).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /projects/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('matches requested id', () => pm.expect(res.data.id).to.eql(pm.environment.get('projectId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /projects/:id",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paused\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('status updated', () => pm.expect(res.data.status).to.eql('paused'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /projects/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
