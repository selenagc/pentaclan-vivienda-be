{
  "info": {
    "name": "Pentaclan Vivienda API",
    "description": "Colección de la API de Pentaclan Vivienda.\n\nIncluye el flujo de autenticación (PV-10: roles admin / social_lead / technical_lead / project_supervisor) y el CRUD de proyectos.\n\nUso rápido:\n1. Selecciona el environment 'Pentaclan Vivienda - Local'.\n2. Ejecuta Auth > Login (guarda accessToken y currentRole automáticamente).\n3. El resto de requests usan {{accessToken}} vía Bearer heredado.\n\nNota: el login devuelve { data: { user, accessToken } } (sin envelope success ni refreshToken).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "pv-collection-0001-0001-0001-000000000001"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('envelope success', () => pm.expect(res.success).to.be.true);",
                  "pm.test('status ok', () => pm.expect(res.data.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const VALID_ROLES = ['admin', 'social_lead', 'technical_lead', 'project_supervisor'];",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const payload = res.data;",
                  "pm.test('accessToken present', () => pm.expect(payload.accessToken).to.be.a('string'));",
                  "pm.test('PV-10: role is valid', () => pm.expect(VALID_ROLES).to.include(payload.user.role));",
                  "pm.environment.set('accessToken', payload.accessToken);",
                  "pm.environment.set('currentRole', payload.user.role);",
                  "pm.environment.set('userId', payload.user.id);",
                  "pm.environment.set('userName', payload.user.name);",
                  "console.log('Logged in as', payload.user.email, '-> role:', payload.user.role);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const VALID_ROLES = ['admin', 'social_lead', 'technical_lead', 'project_supervisor'];",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('no passwordHash leaked', () => pm.expect(res.data).to.not.have.property('passwordHash'));",
                  "pm.test('PV-10: role is valid', () => pm.expect(VALID_ROLES).to.include(res.data.role));",
                  "pm.test('role matches the one from login', () => pm.expect(res.data.role).to.eql(pm.environment.get('currentRole')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "POST /users (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Postman\",\n  \"email\": \"qa_postman@pentaclan.com\",\n  \"password\": \"Test1234!\",\n  \"role\": \"technical_lead\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('no passwordHash leaked', () => pm.expect(res.data).to.not.have.property('passwordHash'));",
                  "pm.environment.set('newUserId', res.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users (admin, paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "role", "value": "", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('data is array', () => pm.expect(res.data).to.be.an('array'));",
                  "pm.test('has pagination meta', () => pm.expect(res.meta).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/:id (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/{{newUserId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{newUserId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('matches requested id', () => pm.expect(res.data.id).to.eql(pm.environment.get('newUserId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /users/:id (admin: cambia rol)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"project_supervisor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/{{newUserId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{newUserId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('role updated', () => pm.expect(res.data.role).to.eql('project_supervisor'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /users/me (auto-edicion)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{adminEmail}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('no passwordHash leaked', () => pm.expect(res.data).to.not.have.property('passwordHash'));",
                  "// El PATCH cambia el propio nombre: se refresca `userName` para que los",
                  "// tests de Projects comparen contra el valor vigente y no contra el viejo.",
                  "pm.environment.set('userName', res.data.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /users/:id (admin, limpia QA)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/{{newUserId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{newUserId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
