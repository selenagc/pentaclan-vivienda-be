    {
      "name": "Proyectos",
      "item": [
        {
          "name": "POST /proyectos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Construccion de viviendas sociales - Fase I\",\n  \"nroContrato\": \"AEV-2026-{{$randomInt}}\",\n  \"entidadPublicaId\": {{entidadId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/proyectos", "host": ["{{baseUrl}}"], "path": ["proyectos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.environment.set('proyectoId', res.data.id);",
                  "pm.environment.set('nroContrato', res.data.nroContrato);",
                  "pm.test('el creador sale de la sesion', () => pm.expect(res.data.usuarioNombre).to.eql(pm.environment.get('userName')));",
                  "pm.test('asocia la entidad financiadora', () => pm.expect(res.data.entidadPublicaId).to.eql(Number(pm.environment.get('entidadId'))));"
                ]
              }
            }
          ]
        },
        {
